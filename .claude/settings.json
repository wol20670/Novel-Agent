{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)",
      "Bash(git branch --merged*)",
      "Bash(git checkout main)",
      "Bash(git switch main)",
      "Bash(git merge --ff-only *)",
      "Bash(git push origin main)",
      "Bash(git branch -d *)",
      "Bash(git push origin --delete *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "echo SESSION START - read HANDOFF.md as the short living state. Do not read docs/contracts or docs/history at startup; follow only the links needed for the current task. Do not edit files during startup. Use /handoff-maintain explicitly when handoff cleanup is needed."
          }
        ]
      }
    ]
  }
}
